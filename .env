# ==============================================================================
# STACKLY AUTHENTICATION PLATFORM - ENVIRONMENT CONFIGURATION (.env)
# Fill in your Firebase and EmailJS credentials below.
# If left with placeholder values, the app operates in Smart Simulation mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTHENTICATION CONFIGURATION
# Obtain these from: Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere12345
VITE_FIREBASE_AUTH_DOMAIN=stackly-auth.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stackly-auth
VITE_FIREBASE_STORAGE_BUCKET=stackly-auth.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. EMAILJS OTP DELIVERY CONFIGURATION
# Obtain these from: https://dashboard.emailjs.com
# ------------------------------------------------------------------------------
# EmailJS Service ID (e.g. service_gmail, service_stackly)
VITE_EMAILJS_SERVICE_ID=service_stackly_otp

# EmailJS Template ID (e.g. template_otp_verification)
VITE_EMAILJS_TEMPLATE_ID=template_otp_stackly

# EmailJS Public Key / User ID (Account -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
